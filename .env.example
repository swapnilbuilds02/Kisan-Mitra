# Kisan Mitra – Environment Template
# Copy to .env and fill in values. NEVER commit the real .env file.

# --- AI (backend-only secrets; never expose to the mobile app) ---
# Free-tier eligible model only. Paid-only models are rejected at client init.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Master switch: false disables ALL external AI calls (non-AI features stay up)
AI_ENABLED=false

# Router priority: kb first, free gemini second, consultant escalation last
AI_PROVIDER_PRIORITY=kb,gemini_free,consultant

# Minimum KB similarity before answering from the Knowledge Base
AI_KB_THRESHOLD=0.78

# Usage limits (free-tier protection; never auto-upgrade to paid)
AI_MAX_REQUESTS_PER_DAY=5000
AI_MAX_REQUESTS_PER_USER_PER_DAY=50
AI_MAX_REQUESTS_PER_USER_PER_MINUTE=6
AI_MAX_IMAGE_BYTES=5242880
AI_MAX_AUDIO_SECONDS=60

# --- Core ---
DATABASE_URL=
REDIS_URL=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEYS_JSON=
JWT_ACTIVE_KID=
OTP_PEPPER=
PASSWORD_RATE_PEPPER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telephony / messaging (paid services require explicit owner approval) ---
EXOTEL_API_KEY=
EXOTEL_API_SECRET=
DLT_SENDER_ID=
OWNER_WHATSAPP_NUMBER=
