# Use HTTPS outside a local emulator. Never put credentials in EXPO_PUBLIC_* values.
EXPO_PUBLIC_API_URL=
# Set only after the approved document is published and the backend has marked
# the same ID/version approved_for_use. Keep empty to disable registration.
EXPO_PUBLIC_CONSENT_DOCUMENT_ID=
EXPO_PUBLIC_CONSENT_VERSION=
EXPO_PUBLIC_CONSENT_URL=
