# Secrets – never commit
.env
*.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / React Native
node_modules/
expo/
.expo/
.next/
*.tsbuildinfo
*.log
npm-debug.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Builds
dist/
build/

# Recovery evidence and independent backup copies (never application source)
/RECOVERY_WORKSPACE/
/Kisan-Mitra-Recovery*/
/Kisan-Mitra-*-Backup-*/
/Kisan-Mitra-Final-Recovery-*/

# Local credentials and signing material
*.pem
!**/public.pem
!**/*.pub.pem
!**/*-public.pem
!**/*_public.pem
*.key
*.p12
*.pfx

# Local databases, dumps, coverage, and generated test output
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
